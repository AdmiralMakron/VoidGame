# Builds
VoidGame/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
VoidGame/!Build/*/
VoidGame/Build/*/**
VoidGame/!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
VoidGame/!Build/**/*.ico

# Built data for maps
VoidGame/*_BuiltData.uasset

# Configuration files generated by the Editor
VoidGame/Saved/*

# Compiled source files for the engine to use
VoidGame/Intermediate/*
VoidGame/Plugins/**/Intermediate/*

# Cache files for the editor to use
VoidGame/DerivedDataCache/*
